# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Next Auth (Auth.js)
AUTH_SECRET= # Run `npx auth secret` or `openssl rand -base64 33` to generate

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Midtrans
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_CLIENT_KEY= # Optional, can use NEXT_PUBLIC_MIDTRANS_CLIENT_KEY instead

#CLOUDINARY
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=